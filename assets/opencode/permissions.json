{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      ".env*": "deny",
      "*/.env*": "deny",
      ".env.example": "allow",
      "*/.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "package.json": "deny",
      "*/package.json": "deny",
      "package-lock.json": "deny",
      ".npmrc": "deny",
      ".env*": "deny",
      "docker-compose.yml": "deny",
      "Makefile": "deny",
      ".github/*": "deny",
      ".husky/*": "deny",
      "commitlint.config.js": "deny",
      "scripts/sync-agents.js": "deny",
      "scripts/check-flow.sh": "deny",
      "scripts/openspec-update.sh": "deny",
      "config/*": "deny",
      ".agent-guidelines/*": "deny",
      "AGENTS.md": "deny",
      "CLAUDE.md": "deny",
      ".cursor/*": "deny",
      "opencode.json": "deny",
      ".opencode/*": "deny",
      "openspec/config.yaml": "deny",
      "openspec/specs/*": "deny"
    },
    "bash": {
      "*": "ask",

      "ls*": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "find *-delete*": "deny",
      "find *-exec*": "ask",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git commit *--no-verify*": "deny",
      "git commit *-n *": "deny",
      "git commit *--amend*": "deny",
      "git push *": "ask",
      "git push *--force*": "deny",
      "git push *-f": "deny",
      "git push *-f *": "deny",
      "git push *--no-verify*": "deny",
      "git checkout *": "deny",
      "git switch *": "deny",
      "git merge *": "deny",
      "git rebase *": "deny",
      "git reset --hard*": "deny",
      "git clean *": "deny",

      "npm ci": "allow",
      "npm install *": "ask",
      "npm i *": "ask",
      "npm uninstall *": "ask",
      "npm install": "allow",
      "npm run *": "allow",
      "npm run openspec-update*": "deny",
      "npm test*": "allow",
      "npm audit*": "allow",
      "npm audit fix*": "deny",
      "npx openspec *": "allow",
      "npx --no -- openspec *": "allow",
      "npx openspec update*": "deny",
      "npx --no -- openspec update*": "deny",
      "npx openspec init*": "deny",
      "npx --no -- openspec init*": "deny",
      "npx openspec config*": "deny",
      "npx --no -- openspec config*": "deny",

      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "sudo *": "deny"
    }
  }
}
